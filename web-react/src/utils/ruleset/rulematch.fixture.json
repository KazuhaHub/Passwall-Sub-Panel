   "note": "NOT takes exactly one condition"
  },
  {
   "rule": "AND,(DOMAIN,claude.ai),Proxy",
   "probe": "web",
   "expect": "unknown",
   "reason": "unsupported",
   "note": "conditions must be parenthesised"
  },
  {
   "rule": "AND,((MATCH),(DOMAIN,claude.ai)),Proxy",
   "probe": "web",
   "expect": "unknown",
   "reason": "unsupported"
  },
  {
   "rule": "AND,((DOMAIN-REGEX,^c{1,3}laude\\.ai$),(NETWORK,TCP)),Proxy",
   "probe": "web",
   "expect": "yes",
   "note": "a comma inside a regex in a logic condition",
